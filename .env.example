# =============================================================================
# DentalFlow SaaS — ejemplo de configuración de entorno
# -----------------------------------------------------------------------------
# Uso:
#   cp .env.example .env
#   php artisan key:generate
# Requiere PostgreSQL >= 14. Multi-tenant (Stancl Tenancy) con una única base
# de datos compartida aislada por clinic_id.
# NUNCA subas el archivo .env real al repositorio.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
APP_NAME=DentalFlow
APP_ENV=local                 # local | testing | production
APP_KEY=                      # se genera con: php artisan key:generate
APP_DEBUG=true                # en producción: false
# En local con tenancy por subdominio se usa p.ej. http://clinic1.localhost:8000
APP_URL=http://localhost:8000

# --- Localización -----------------------------------------------------------
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Mantenimiento ----------------------------------------------------------
APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logs -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # en producción: error

# --- Base de datos (PostgreSQL >= 14, obligatorio) --------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dentalflowsaas
DB_USERNAME=postgres
DB_PASSWORD=

# --- Sesión -----------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Broadcast / Archivos / Colas -------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public        # se sufija como tenant{clinic_id} cuando hay tenant activo
QUEUE_CONNECTION=database

# --- Caché ------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# --- Redis (opcional) -------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo -----------------------------------------------------------------
MAIL_MAILER=log               # en producción: smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Almacenamiento S3 (opcional) -------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Multi-tenancy ----------------------------------------------------------
# Dominios centrales (sin tenant). En local: localhost y 127.0.0.1.
# En producción, pon aquí tu dominio principal; las clínicas se acceden como
# {clinica}.tudominio.com  ->  p.ej. TENANCY_CENTRAL_DOMAINS=dentalflow.digitalwebsolution.info
TENANCY_CENTRAL_DOMAINS=localhost:8000,127.0.0.1:8000

# --- Contacto (landing pública / lista de espera) ---------------------------
CONTACT_EMAIL=
CONTACT_WHATSAPP=
WAITLIST_COUNT=
